{
  "name": "SIMPLE_CNN",
  "phase": "SIMPLE",
  "notes": "CNN 1D t\u00e1\u00bb\u2018i gi\u00e1\u00ba\u00a3n: 3 l\u00e1\u00bb\u203ap conv, Adam, CrossEntropy, kh\u00c3\u00b4ng scheduler/sweep",
  "n_splits": 3,
